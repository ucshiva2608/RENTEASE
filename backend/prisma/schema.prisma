// RentEase Prisma Schema
// Compatible with SQLite (for zero-dependency local execution) and PostgreSQL (production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
  password                String
  phone                   String?
  role                    String    @default("TENANT") // OWNER, TENANT, ADMIN
  isIdentityVerified      Boolean   @default(false)
  identityDocType         String?   // AADHAAR, PASSPORT, VOTER_ID, PAN
  identityDocNumberMasked String?   // e.g. XXXX-XXXX-4892
  identityVerifiedAt      DateTime?
  consentPersonalData     Boolean   @default(true)
  consentAuditLogging     Boolean   @default(true)
  aiQueryQuotaRemaining   Int       @default(150)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  propertiesOwned         Property[]         @relation("OwnerProperties")
  applications            TenantApplication[]
  agreementsAsTenant      RentalAgreement[]   @relation("TenantAgreements")
  agreementsAsOwner       RentalAgreement[]   @relation("OwnerAgreements")
  maintenanceTickets      MaintenanceTicket[]
  depositRecordsAsOwner   DepositRecord[]     @relation("OwnerDepositRecords")
  depositRecordsAsTenant  DepositRecord[]     @relation("TenantDepositRecords")
  auditLogs               AuditLog[]
}

model Property {
  id                           String    @id @default(uuid())
  title                        String
  description                  String
  address                      String
  city                         String
  state                        String
  pincode                      String
  latitude                     Float
  longitude                    Float
  monthlyRent                  Float
  securityDeposit              Float
  bedrooms                     Int
  bathrooms                    Int
  furnishing                   String    @default("SEMI_FURNISHED") // FURNISHED, SEMI_FURNISHED, UNFURNISHED
  propertyType                 String    @default("APARTMENT") // APARTMENT, INDEPENDENT_HOUSE, VILLA, STUDIO
  amenities                    String    // JSON string array e.g. '["Parking","Gym","Power Backup","Elevator","Security"]'
  squareFeet                   Int
  isAvailable                  Boolean   @default(true)
  images                       String    // JSON string array of URLs
  videoUrl                     String?
  imageHash                    String?   // Perceptual / SHA-256 hash for duplicate listing detection
  listingConfirmedAt           DateTime  @default(now())
  ownerId                      String
  owner                        User      @relation("OwnerProperties", fields: [ownerId], references: [id])

  // Module 1: Trust & Verification
  verificationStatus           String    @default("PENDING") // PENDING, VERIFIED, REJECTED, EXPIRED
  verificationExpiry           DateTime?
  verifiedAt                   DateTime?
  adminReviewNotes             String?
  reviewedByAdminId            String?
  badgeIdentityVerified        Boolean   @default(false)
  badgeOwnershipDocsReviewed   Boolean   @default(false)
  badgeLocationVerified        Boolean   @default(false)
  badgeMediaVerified           Boolean   @default(false)
  badgeRecentlyConfirmed       Boolean   @default(true)
  ownershipDocUrl              String?
  ownershipDocType             String?   // SALE_DEED, PROPERTY_TAX_RECEIPT, ELECTRICITY_BILL, POWER_OF_ATTORNEY
  duplicateListingDetected     Boolean   @default(false)
  duplicateListingReferenceId  String?

  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  applications                 TenantApplication[]
  agreements                   RentalAgreement[]
  maintenanceTickets           MaintenanceTicket[]
  depositRecords               DepositRecord[]
}

model DepositRecord {
  id                      String    @id @default(uuid())
  propertyId              String
  property                Property  @relation(fields: [propertyId], references: [id])
  tenantId                String
  tenant                  User      @relation("TenantDepositRecords", fields: [tenantId], references: [id])
  ownerId                 String
  owner                   User      @relation("OwnerDepositRecords", fields: [ownerId], references: [id])
  originalDepositAmount   Float
  depositPaidDate         DateTime  @default(now())
  receiptReference        String
  escrowStatus            String    @default("HELD_IN_ESCROW_ACCOUNT") // HELD_IN_ESCROW_ACCOUNT, RELEASE_PENDING, DISPUTED, REFUNDED
  disclaimer              String    @default("RentEase provides immutable deposit accounting & itemized damage adjudication; fund movement clears via banking escrow partner.")
  totalDeductions         Float     @default(0)
  calculatedRefundAmount  Float
  ownerSigned             Boolean   @default(false)
  ownerSignedAt           DateTime?
  tenantSigned            Boolean   @default(false)
  tenantSignedAt          DateTime?
  disputeRaised           Boolean   @default(false)
  disputeReason           String?
  disputeStatus           String    @default("NONE") // NONE, OPEN, IN_MEDIATION, RESOLVED
  disputeResolutionNotes  String?
  refundPaidDate          DateTime?
  refundTransactionRef    String?
  refundStatus            String    @default("PENDING") // PENDING, APPROVED, DISPUTED, COMPLETED
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  inspections             InspectionReport[]
  deductionItems          DepositDeductionItem[]
}

model InspectionReport {
  id               String        @id @default(uuid())
  depositRecordId  String
  depositRecord    DepositRecord @relation(fields: [depositRecordId], references: [id])
  inspectionType   String        // MOVE_IN, MOVE_OUT
  inspectorName    String
  inspectionDate   DateTime      @default(now())
  overallCondition String        // EXCELLENT, GOOD, FAIR, DAMAGED
  checklistJson    String        // JSON: {"walls":"good","plumbing":"ok","electrical":"good","fixtures":"intact"}
  photosJson       String        // JSON array of {url, timestamp, sha256Hash, notes}
  tenantAgreed     Boolean       @default(false)
  ownerAgreed      Boolean       @default(false)
  createdAt        DateTime      @default(now())
}

model DepositDeductionItem {
  id              String        @id @default(uuid())
  depositRecordId String
  depositRecord   DepositRecord @relation(fields: [depositRecordId], references: [id])
  category        String        // PAINTING, CLEANING, PLUMBING_REPAIR, ELECTRICAL_REPAIR, CARPENTRY, UNPAID_UTILITIES, OTHER
  description     String
  claimedAmount   Float
  agreedAmount    Float
  proofPhotoUrl   String?
  invoiceProofUrl String?
  tenantApproved  Boolean       @default(false)
  createdAt       DateTime      @default(now())
}

model MaintenanceTicket {
  id                     String    @id @default(uuid())
  propertyId             String
  property               Property  @relation(fields: [propertyId], references: [id])
  tenantId               String
  tenant                 User      @relation(fields: [tenantId], references: [id])
  title                  String
  description            String
  complaintInputType     String    @default("TEXT") // TEXT, IMAGE, VOICE
  audioRecordingUrl      String?
  audioTranscript        String?
  photoUrlsJson          String?   // JSON array of photo URLs
  aiClassifiedCategory   String    // PLUMBING, ELECTRICAL, HVAC, CARPENTRY, APPLIANCE, STRUCTURAL, PEST_CONTROL
  aiSuggestedUrgency     String    // EMERGENCY, HIGH, MEDIUM, LOW
  slaHours               Int       // e.g. 4 for emergency, 12 for high, 48 for medium, 120 for low
  slaDeadline            DateTime
  status                 String    @default("OPEN") // OPEN, IN_PROGRESS, AWAITING_OWNER_APPROVAL, COMPLETED, ESCALATED
  isEscalated            Boolean   @default(false)
  escalatedAt            DateTime?
  recommendedProviderJson String?  // JSON { name, trade, rating, phone, estimatedCostRange }
  assignedVendorName     String?
  assignedVendorPhone    String?
  quoteAmount            Float?
  quoteDescription       String?
  quoteApprovedByOwner   Boolean   @default(false)
  repairEvidencePhotosJson String? // JSON array of {beforeUrl, afterUrl, completionDate}
  tenantSatisfactionRating Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model RentalAgreement {
  id                       String    @id @default(uuid())
  propertyId               String
  property                 Property  @relation(fields: [propertyId], references: [id])
  ownerId                  String
  owner                    User      @relation("OwnerAgreements", fields: [ownerId], references: [id])
  tenantId                 String
  tenant                   User      @relation("TenantAgreements", fields: [tenantId], references: [id])
  agreementDocumentUrl     String?
  startDate                DateTime
  endDate                  DateTime
  monthlyRent              Float
  securityDeposit          Float
  lockInPeriodMonths       Int       @default(6)
  noticePeriodDays         Int       @default(30)
  escalationPercent        Float     @default(5.0)
  stateJurisdiction        String    @default("Telangana")
  status                   String    @default("ACTIVE") // DRAFT, ACTIVE, EXPIRING_SOON, EXPIRED, TERMINATED
  extractedClausesJson     String?   // JSON of extracted structural clauses
  aiSummaryEn              String?
  aiSummaryTe              String?   // Telugu explanation
  missingInformationAlerts String?   // JSON array of missing clauses or risks
  listingDiscrepancyNotes  String?   // Comparison notes between listing and signed agreement
  renewalReminderSent      Boolean   @default(false)
  disclaimer               String    @default("RentEase AI Agreement Intelligence provides automated text analysis and summary for informational purposes only. It does not constitute formal legal counsel.")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  payments                 RentPayment[]
}

model TenantApplication {
  id              String    @id @default(uuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id])
  tenantId        String
  tenant          User      @relation(fields: [tenantId], references: [id])
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  applicantIncome Float
  occupantsCount  Int
  message         String?
  createdAt       DateTime  @default(now())
}

model RentPayment {
  id            String          @id @default(uuid())
  agreementId   String
  agreement     RentalAgreement @relation(fields: [agreementId], references: [id])
  amount        Float
  dueDate       DateTime
  paidDate      DateTime?
  status        String          @default("PAID") // PAID, OVERDUE, PENDING
  receiptNumber String
  paymentMethod String          @default("UPI") // UPI, BANK_TRANSFER, CARD
  createdAt     DateTime        @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  detailsJson String
  ipAddress   String?  @default("127.0.0.1")
  timestamp   DateTime @default(now())
}
