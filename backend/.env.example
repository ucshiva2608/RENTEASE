# Port (Render sets this automatically in production)
PORT=5000

# Environment Mode
NODE_ENV=production

# Database Connection URL (from Neon PostgreSQL console)
# Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secure Secret for JSON Web Tokens
JWT_SECRET=rentease_super_secure_jwt_secret_key_2026

# Allowed Frontend Origins (Comma-separated, e.g. https://rentease.vercel.app)
ALLOWED_ORIGINS=

# AI & Rate Limit Settings
AI_RATE_LIMIT=150
AI_MODEL_FALLBACK=true
